#!/bin/bash

set -euo pipefail
shopt -s nullglob

rollback_one() {
    local base="$1"
    local max_n=0
    local n=1

    [[ -f "${base}.old" || -f "${base}.old.1" ]] || return 0

    while [[ -f "${base}.old.${n}" ]]; do
        max_n=$n
        ((n++))
    done

    [[ -f "${base}.old" ]] && rm -f -- "${base}.old"

    for ((i=1; i<=max_n; i++)); do
        if [[ $i -eq 1 ]]; then
            mv -- "${base}.old.1" "${base}.old"
        else
            mv -- "${base}.old.${i}" "${base}.old.$((i-1))"
        fi
    done
}

for base in ML_LOGFILE XDATCAR; do
    rollback_one "$base"
done

max_slurm_file=""
max_job_id=-1

for f in slurm-*.old; do
    [[ -f "$f" ]] || continue

    if [[ "$f" =~ ^slurm-([0-9]+).*\.old$ ]]; then
        id="${BASH_REMATCH[1]}"
        if (( id > max_job_id )); then
            max_job_id=$id
            max_slurm_file="$f"
        fi
    fi
done

if [[ -n "$max_slurm_file" ]]; then
    echo "Removing $max_slurm_file"
    rm -f -- "$max_slurm_file"
fi
