#!/bin/bash

set -euo pipefail
shopt -s nullglob

[[ -f ML_LOGFILE ]] || { echo "Error: ML_LOGFILE not found." >&2; exit 1; }
[[ -f INCAR ]] || { echo "Error: INCAR not found." >&2; exit 1; }
[[ -f run.sh ]] || { echo "Error: run.sh not found." >&2; exit 1; }

if [[ -n "${1:-}" ]]; then
    [[ "$1" =~ ^[0-9]+$ ]] || { echo "Error: time argument must be an integer hour." >&2; exit 1; }
fi

rotate_backup() {
    local base="$1"
    local n=1

    [[ -f "$base" ]] || return 0

    while [[ -f "${base}.old.${n}" ]]; do
        ((n++))
    done

    for ((i=n; i>=2; i--)); do
        mv -- "${base}.old.$((i-1))" "${base}.old.${i}"
    done

    [[ -f "${base}.old" ]] && mv -- "${base}.old" "${base}.old.1"
    mv -- "$base" "${base}.old"
}

threshold=$(awk '/BEEF/ {x=$6} END{print x}' ML_LOGFILE)

if [[ -z "${threshold:-}" ]]; then
    echo "Error: failed to extract the threshold in ML_LOGFILE." >&2
    exit 1
fi

if grep -q '^[[:space:]]*ML_CTIFOR' INCAR; then
    sed -i "s/^[[:space:]]*ML_CTIFOR.*/ML_CTIFOR = $threshold/" INCAR
else
    echo "ML_CTIFOR = $threshold" >> INCAR
fi

if [[ -n "${1:-}" ]]; then
    sed -E -i "s/--time=[0-9]{1,2}:[0-9]{2}:[0-9]{2}/--time=${1}:00:00/g" run.sh
fi

[[ -f CONTCAR ]] && mv -- CONTCAR POSCAR
[[ -f ML_ABN ]] && mv -- ML_ABN ML_AB

for f in ML_LOGFILE XDATCAR; do
    rotate_backup "$f"
done

for f in slurm*; do
    [[ -f "$f" ]] && mv -- "$f" "$f.old"
done

find . -maxdepth 1 -type f ! \( \
    -name 'INCAR' -o \
    -name 'POSCAR' -o \
    -name 'POTCAR' -o \
    -name 'KPOINTS' -o \
    -name 'ML_AB' -o \
    -name '*.old' -o \
    -name 'ML_LOGFILE.old.*' -o \
    -name 'XDATCAR.old.*' -o \
    -name '*.sh' \
\) -exec rm -f {} +

echo "ML_CTIFOR = $threshold"
[[ -n "${1:-}" ]] && echo "Updated run.sh time limit to: ${1}:00:00"

sbatch run.sh
